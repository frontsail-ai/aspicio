{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023", "dom"],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "paths": {
      "@aspicio/core/dxf": ["../core/src/dxf.ts"],
      "@aspicio/core/pdf": ["../core/src/pdf.ts"],
      "@aspicio/core": ["../core/src/index.ts"],
      "@aspicio/elements/formats/dxf": ["../elements/src/formats/dxf.ts"],
      "@aspicio/elements/formats/pdf": ["../elements/src/formats/pdf.ts"],
      "@aspicio/elements": ["../elements/src/index.ts"]
    },
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
