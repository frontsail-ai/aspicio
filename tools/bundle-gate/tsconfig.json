{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "dom"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  /*
   * Fixtures are build inputs, not source: they resolve `@aspicio/*` through
   * node_modules and `exports` (that is the whole point — see README), which
   * only exists after a build. `vp check` runs before builds, so type-checking
   * them here would fail on a clean tree. Vite resolves them at gate time.
   */
  "include": ["tests/**/*.ts"]
}
